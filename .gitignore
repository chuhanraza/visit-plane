# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare (opennextjs-cloudflare)
.open-next/
.wrangler/
.dev.vars

# build-generated mirror of content/blog/ for the Workers ASSETS binding —
# regenerated by `npm run sync:blog-content` (see scripts/sync-blog-content.mjs)
/public/blog-content/

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code agent files
.claude/
