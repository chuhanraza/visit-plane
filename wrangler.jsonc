{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visitplane",
  // Thin wrapper (outside .open-next/, which is fully regenerated on every
  // build) that re-exports the OpenNext fetch handler unchanged and adds a
  // `scheduled` export for the daily cron trigger below. See worker-entry.ts.
  "main": "worker-entry.ts",
  // 2026-07-08 satisfies both the fs auto-enable date (2025-09-15+) and the
  // child_process module-stub auto-enable date (2026-03-17+) — see
  // app/api/visa/run-pipeline/route.ts for why the latter doesn't actually
  // help us (Workers has no OS process model regardless of the stub).
  "compatibility_date": "2026-07-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "visitplane"
    }
  ],

  // ── Incremental cache (ISR) — none, by design ─────────────────────────────
  // No R2 bucket, no KV namespace. R2 requires a card on file even for its
  // free tier — off the table, the user isn't adding one. KV doesn't require
  // a card, but its free tier (1,000 writes/day) is the exact ceiling that
  // caused the original Vercel ISR-write outage, so it's not a safe fallback
  // either. open-next.config.ts intentionally passes no `incrementalCache`
  // override, which uses OpenNext's documented no-op "dummy" cache instead —
  // zero bindings, zero billing surface. Acceptable now that ISR churn is low
  // (bots blocked at the edge, revalidate lengthened to 30 days on the
  // heaviest templates).

  // Per-deploy version id, used by worker-entry.ts to key the edge page cache.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "observability": {
    "enabled": true
  },

  // ── Billing circuit-breaker config (see app/api/cron/billing-guard) ────────
  // Plain vars only — nothing here is sensitive. The one genuinely new secret,
  // CLOUDFLARE_BILLING_API_TOKEN (a *separate*, Billing:Read-only token — the
  // existing deploy/wrangler credential has no billing scope and can't be
  // reused), does not exist yet and must be created by hand in the Cloudflare
  // dashboard, then set with `wrangler secret put CLOUDFLARE_BILLING_API_TOKEN`.
  // BILLING_GUARD_ARMED defaults to "false" (dry-run/alert-only) deliberately —
  // per the safety requirement, arming is a separate, manual step, never a
  // default. Flipping it to "true" requires editing this file and redeploying
  // (or `wrangler secret put` if changed to a secret) — not a toggle a bug in
  // application code could ever flip on its own.
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "1068890dae6e2dde22dd81bdbf199830",
    "BILLING_GUARD_ARMED": "false",
    "BILLING_GUARD_THRESHOLD_USD": "0.50",
    "BILLING_GUARD_ALERT_EMAIL": "relianmfg@gmail.com"
  },

  // 08:00 UTC daily: matches the cadence the old Vercel cron used for
  // /api/cron/flows (see vercel.json, now dead weight post-migration) — hits
  // /api/cron/flows (dormant welcome-sequence worker) and the newer
  // /api/cron/lifecycle (win-back + confirm-nudge tracks).
  // */15 * * * *: billing circuit-breaker check (see worker-entry.ts
  // `scheduled`, branches on event.cron) — frequent enough to catch a runaway
  // cost trend within ~15 minutes, cheap enough (one Billable Usage API call)
  // to be negligible cost itself.
  "triggers": {
    "crons": ["0 8 * * *", "*/15 * * * *"]
  }
}
