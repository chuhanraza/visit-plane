{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visitplane",
  // Thin wrapper (outside .open-next/, which is fully regenerated on every
  // build) that re-exports the OpenNext fetch handler unchanged and adds a
  // `scheduled` export for the daily cron trigger below. See worker-entry.ts.
  "main": "worker-entry.ts",
  // 2026-07-08 satisfies both the fs auto-enable date (2025-09-15+) and the
  // child_process module-stub auto-enable date (2026-03-17+) — see
  // app/api/visa/run-pipeline/route.ts for why the latter doesn't actually
  // help us (Workers has no OS process model regardless of the stub).
  "compatibility_date": "2026-07-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "visitplane.com", "custom_domain": true },
    { "pattern": "www.visitplane.com", "custom_domain": true }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "visitplane"
    }
  ],

  // ── Incremental cache (ISR) — none, by design ─────────────────────────────
  // No R2 bucket, no KV namespace. R2 requires a card on file even for its
  // free tier — off the table, the user isn't adding one. KV doesn't require
  // a card, but its free tier (1,000 writes/day) is the exact ceiling that
  // caused the original Vercel ISR-write outage, so it's not a safe fallback
  // either. open-next.config.ts intentionally passes no `incrementalCache`
  // override, which uses OpenNext's documented no-op "dummy" cache instead —
  // zero bindings, zero billing surface. Acceptable now that ISR churn is low
  // (bots blocked at the edge, revalidate lengthened to 30 days on the
  // heaviest templates).

  "observability": {
    "enabled": true
  },

  // Daily at 08:00 UTC — matches the cadence the old Vercel cron used for
  // /api/cron/flows (see vercel.json, now dead weight post-migration). Fires
  // worker-entry.ts's `scheduled` handler, which hits /api/cron/flows (the
  // existing welcome-sequence worker — dormant since the Cloudflare move,
  // since Vercel crons don't reach this deployment) and the new
  // /api/cron/lifecycle (win-back + confirm-nudge tracks) in one tick.
  "triggers": {
    "crons": ["0 8 * * *"]
  }
}
